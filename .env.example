# ── Database ──
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Authentication ──
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=https://playbook-iota-ecru.vercel.app

# ── Development & Fallbacks (NEVER enable in production) ──
ENABLE_DEV_AUTH=false
USE_STATIC_DATA=false

# ── WordPress Knowledge Base ──
WORDPRESS_KB_URL=https://kb.softprowatersystems.com

# ── Vercel Cron protection ──
CRON_SECRET=generate-a-strong-random-secret

# ── OAuth Providers (Optional, configure 1) ──

# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID / Microsoft 365
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
